APP_NAME=Plant Disease Diagnosis API
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# Paths are relative to backend/ for local runs. docker-compose overrides them
# with /app/models and /app/uploads for the container.
MODEL_PATH=models/efficientnet_v2_s_best.torchscript.pt
CLASS_LABELS_PATH=models/class_labels.json
LOW_CONFIDENCE_THRESHOLD=0.70
MAX_CONCURRENT_INFERENCES=1

MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=25000000
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_DIMENSION=10000
STORE_UPLOADS=true
UPLOAD_DIR=uploads
IMAGE_JPEG_QUALITY=90

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=90
GROQ_HEALTH_TIMEOUT_SECONDS=10
GROQ_HEALTH_CACHE_SECONDS=30
GROQ_MAX_TOKENS=4096
# auto | low | medium | high | none. "auto" only sends the parameter to Groq
# reasoning models such as openai/gpt-oss-*.
GROQ_REASONING_EFFORT=auto
GROQ_MAX_PAYLOAD_CHARS=12000
GROQ_MAX_RETRIES=2
MAX_CONCURRENT_GROQ_REQUESTS=2

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_key
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT_SECONDS=45
SEARCH_MAX_RESULTS_PER_QUERY=5
SEARCH_MAX_QUERIES_PER_NODE=2
MAX_CONCURRENT_SEARCH_REQUESTS=6
# Jurisdiction used when researching pesticide registration.
RESEARCH_COUNTRY=Pakistan

CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
